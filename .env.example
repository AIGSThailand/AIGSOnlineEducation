# ==============================================================================
# AIGS Online Education Platform - Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Note: Same as publishable key (interchangeable naming in modern Supabase SDK)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Service Role Key - CRITICAL: Server-side ONLY, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Stripe Configuration
# ------------------------------------------------------------------------------
# Stripe Public Key (safe for browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Secret Key - CRITICAL: Server-side ONLY, NEVER expose to browser
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Webhook Signing Secret (from `stripe listen` or Stripe Dashboard -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
