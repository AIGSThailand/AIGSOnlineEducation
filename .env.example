# ==============================================================================
# AIGS Online Education Platform - Environment Configuration
# ==============================================================================
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real secrets. See docs/environments.md for local/staging/production.

# ------------------------------------------------------------------------------
# Runtime environment (local | staging | production)
# ------------------------------------------------------------------------------
# local      — Supabase CLI (127.0.0.1:54321) + Stripe test
# staging    — Dedicated Supabase staging project + Stripe test
# production — Dedicated Supabase production project + Stripe live
APP_ENV=local

# Application base URL (auth redirects, Stripe success/cancel URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase (Dashboard -> Project Settings -> API, or `supabase status` locally)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: use Publishable key from `npm run supabase:status` (sb_publishable_...)
# Hosted: use anon JWT from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-or-hosted-anon-or-publishable-key

# Service role — SERVER ONLY. Never expose to the browser.
# Local: use Secret key from `npm run supabase:status` (sb_secret_...)
# Hosted: use service_role JWT from Dashboard → Settings → API
SUPABASE_SERVICE_ROLE_KEY=your-local-or-hosted-service-role-or-secret-key

# Optional: allow hosted Supabase URL when APP_ENV=local (default: warn only)
# ALLOW_HOSTED_SUPABASE_LOCAL=true

# ------------------------------------------------------------------------------
# Stripe (test mode for local and staging; live mode for production only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: allow sk_test_* when APP_ENV=production (controlled ops only)
# ALLOW_STRIPE_TEST_IN_PRODUCTION=true

# ------------------------------------------------------------------------------
# AWS S3 media (optional — Course Builder uploads)
# ------------------------------------------------------------------------------
# If unset, builders fall back to pasting CDN/S3/WordPress URLs manually.
# See docs/media-s3.md
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=aigs-lms-media-local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Public read base (CloudFront preferred) — no trailing slash
# AWS_S3_PUBLIC_BASE_URL=https://dxxxxxx.cloudfront.net
# AWS_CLOUDFRONT_URL=https://dxxxxxx.cloudfront.net
# AWS_S3_PRESIGN_EXPIRES=300
