# ==============================================================================
# AIGS Online Education Platform - Environment Configuration
# ==============================================================================
# Create one file per CLI target (all gitignored — never commit secrets):
#   cp .env.example .env.local              # npm run dev + default CLI (--env local)
#   cp .env.example .env.cli.staging        # CLI against staging (--env staging)
#   cp .env.example .env.cli.production     # CLI against production (--env production)
#
# Do NOT use `.env.production` for CLI secrets — Next.js loads it during `next build`.
# Next.js only auto-loads .env.local for `npm run dev`.
# Deployed staging/production apps use Vercel env vars, not these files.
# See docs/environments.md.

# ------------------------------------------------------------------------------
# Runtime environment (local | staging | production)
# ------------------------------------------------------------------------------
# local      — Supabase CLI (127.0.0.1:54321) + Stripe test
# staging    — Dedicated Supabase staging project + Stripe test
# production — Dedicated Supabase production project + Stripe live
APP_ENV=local

# Application base URL (auth redirects, Stripe success/cancel URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase (Dashboard -> Project Settings -> API, or `supabase status` locally)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: use Publishable key from `npm run supabase:status` (sb_publishable_...)
# Hosted: use anon JWT from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-or-hosted-anon-or-publishable-key

# Service role — SERVER ONLY. Never expose to the browser.
# Local: use Secret key from `npm run supabase:status` (sb_secret_...)
# Hosted: use service_role JWT from Dashboard → Settings → API
SUPABASE_SERVICE_ROLE_KEY=your-local-or-hosted-service-role-or-secret-key

# Optional: allow hosted Supabase URL when APP_ENV=local (default: warn only)
# ALLOW_HOSTED_SUPABASE_LOCAL=true

# ------------------------------------------------------------------------------
# Stripe (test mode for local and staging; live mode for production only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: allow sk_test_* when APP_ENV=production (controlled ops only)
# ALLOW_STRIPE_TEST_IN_PRODUCTION=true

# ------------------------------------------------------------------------------
# AWS S3 media (optional — Course Builder uploads)
# ------------------------------------------------------------------------------
# If unset, builders fall back to pasting CDN/S3/WordPress URLs manually.
# See docs/media-s3.md
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=aigs-lms-media-local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Access mode: public (CDN URLs) | private (presigned GET via /api/media/file)
# AWS_S3_MEDIA_ACCESS=private
# Public read base — required only when AWS_S3_MEDIA_ACCESS=public (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=https://dxxxxxx.cloudfront.net
# AWS_CLOUDFRONT_URL=https://dxxxxxx.cloudfront.net
# AWS_S3_PRESIGN_EXPIRES=300
# Short TTL for private signed GET (default 60)
# AWS_S3_SIGNED_GET_EXPIRES=60

# ------------------------------------------------------------------------------
# LearnDash REST API (migration inspect + single-course write)
# ------------------------------------------------------------------------------
# WordPress Application Password for a user that can read LD REST v2.
# Never commit real values. See features/migration/learndash/README.md
# LEARNDASH_BASE_URL=https://your-wordpress-site.example
# LEARNDASH_USERNAME=
# LEARNDASH_APP_PASSWORD=
# Optional tuning:
# LEARNDASH_PER_PAGE=50
# LEARNDASH_TIMEOUT_MS=30000
# LEARNDASH_MAX_RETRIES=3
# LEARNDASH_CONCURRENCY=5
# Only for intentional production Supabase writes with migrate:learndash-course --write:
# ALLOW_LEARNDASH_MIGRATE_PRODUCTION=true
